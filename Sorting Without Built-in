class BubbleSort {
    public static void main(String[] args) {
        int arr[] = {5,3,8,1};

        for(int i=0;i<arr.length;i++){
            for(int j=0;j<arr.length-i-1;j++){
                if(arr[j] > arr[j+1]){
                    int t = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = t;
                }
            }
        }

        for(int n:arr) System.out.print(n+" ");
    }
}
